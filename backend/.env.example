# Copy to backend/.env to override defaults. All variables are prefixed LDW_.
LDW_LLM_BASE_URL=http://127.0.0.1:8080
LDW_LOCAL_ONLY=true
# Tokens reserved for a chat answer, and for a generated Word / Excel / PowerPoint file.
LDW_MAX_OUTPUT_TOKENS=1024
LDW_GENERATION_MAX_OUTPUT_TOKENS=3072
LDW_CONTEXT_SAFETY_RESERVE=1024
# Longest silence allowed while llama-server works (it reports reading progress in between).
LDW_LLM_TIMEOUT_SECONDS=600
LDW_MAX_UPLOAD_BYTES=52428800
LDW_URL_FETCH_TIMEOUT_SECONDS=15
LDW_URL_MAX_BYTES=5242880
# LDW_PDF_OCR=true   # requires Tesseract; optional
